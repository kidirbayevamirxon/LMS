# Server
NODE_ENV=development
PORT=3001
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,capacitor://localhost,http://localhost,https://localhost

# Database
DATABASE_URL="postgresql://edumanager:edumanager_secret_2026@localhost:5432/edumanager_db?schema=public"

# JWT & Security
JWT_ACCESS_SECRET="change_this_super_secret_access_key_32chars_min_2026"
JWT_REFRESH_SECRET="change_this_super_secret_refresh_key_32chars_min_2026"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# AES-256-GCM Face Embedding Encryption Key (64 hex chars = 32 bytes)
FACE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Click / Payme Payment Gateways (optional)
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

# Firebase Cloud Messaging (optional path or JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=""
